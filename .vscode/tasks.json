{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill-capsicain",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-Command", "while ($true) { $procs = Get-Process -Name capsicain -ErrorAction SilentlyContinue; if (-not $procs) { break }; $procs | ForEach-Object { try { Stop-Process -Id $_.Id -Force -ErrorAction SilentlyContinue } catch {} }; Start-Sleep -Milliseconds 200 }; exit 0"
            ]
        },
        {
            "label": "build-capsicain",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Build.ps1",
                "-BuildType",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-tests",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/capsicain/build/cmake-x64-Debug",
                "--target",
                "capsicain_tests",
                "--config",
                "Debug"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run-tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "-C",
                "Debug",
                "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}/capsicain/build/cmake-x64-Debug"
            },
            "group": "test",
            "dependsOn": "build-tests"
        },
        {
            "label": "pre-debug-capsicain",
            "dependsOn": [
                "kill-capsicain",
                "build-capsicain"
            ],
            "dependsOrder": "sequence"
        }
    ]
}
